{
  "model_name": "BMS-Dual-Transformer",
  "version": "1.0.0-prototype",
  "model_file": "transformer(1).onnx",
  "window_size": 32,
  "features": [
    "voltage",
    "current",
    "temperature"
  ],
  "enable_normalization": false,
  "normalization_method": "minmax",
  "scaler": {
    "voltage": {
      "min": 2.5,
      "max": 4.2,
      "mean": 3.7,
      "std": 0.3
    },
    "current": {
      "min": -20.0,
      "max": 20.0,
      "mean": 0.0,
      "std": 5.0
    },
    "temperature": {
      "min": 0.0,
      "max": 60.0,
      "mean": 25.0,
      "std": 10.0
    }
  },
  "guardrails": {
    "clip_soh": true,
    "soh_min": 0.0,
    "soh_max": 1.5
  }
}
